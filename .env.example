# Firebase Functions URL (deployed Cloud Function URL or local emulator origin).
# In production this is the deployed Cloud Function URL for the `plant-pwa-prod`
# project (set by the parent agent after `firebase deploy --only functions` —
# issue #10). For local dev, the Firebase Hosting + Functions rewrite makes
# "/api" hit the function locally without a CORS round-trip.
#
# Example (production): https://us-central1-plant-pwa-prod.cloudfunctions.net
# Example (emulator):  http://localhost:5001/plant-pwa-prod/us-central1
VITE_FIREBASE_FUNCTIONS_URL=/api

# API keys live ONLY on the server. The Firebase Functions runtime reads
# them from the function's secret store at boot:
#   firebase functions:secrets:set PLANTNET_API_KEY
#   firebase functions:secrets:set MIMO_API_KEY
# These values must NEVER reach the client bundle. See README.md →
# "Firebase setup" for the secret-bootstrap dance.
# PLANTNET_API_KEY=   (server-side only — set via `firebase functions:secrets:set`)
# MIMO_API_KEY=       (server-side only — set via `firebase functions:secrets:set`)
