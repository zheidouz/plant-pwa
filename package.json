{
  "name": "plant-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-first PWA that turns the phone camera into a plant-care assistant (Pl@ntNet + MiMo).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --host",
    "preview:strict": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "fixtures": "node scripts/generate-fixtures.cjs",
    "postinstall": "node scripts/generate-fixtures.cjs || true"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^2.1.5",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
